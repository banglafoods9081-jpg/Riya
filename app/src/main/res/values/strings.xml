<resources>
    <string name="app_name">Riya</string>
    <string name="app_tagline">Your Warm Voice Companion &amp; Phone Controller</string>
    <string name="accessibility_service_description">Allows Riya to open apps, tap, type, scroll, control YouTube/media, and read screen content on your voice command. Banking, UPI, PIN, and OTP screens are strictly blocked.</string>

    <!-- Onboarding -->
    <string name="onboarding_greeting_title">Hii, ami Riya</string>
    <string name="onboarding_greeting_subtitle">Tomar kotha shunte, phone chalate, ar pashe thakte ami ready. Bengali, Banglish, Hindi ba English — je bhashay bolbe, sheibhabei kotha bolbo.</string>
    <string name="onboarding_name_label">Tomake ki bole dakbo? (Your Name)</string>
    <string name="onboarding_name_placeholder">e.g., Rohan</string>
    <string name="onboarding_language_label">Default Language</string>
    <string name="onboarding_safety_title">Safety &amp; Privacy Promise</string>
    <string name="onboarding_safety_body">All chats and memories stay locally on your device. Your Grok API key is encrypted with Android Keystore. Riya never automates banking, UPI PINs, OTPs, or password screens.</string>
    <string name="onboarding_continue">Start Setup</string>

    <!-- Permissions -->
    <string name="permissions_title">Riya Permissions</string>
    <string name="permissions_subtitle">Step-by-step access so Riya can hear you, speak warmly, and control your phone safely.</string>
