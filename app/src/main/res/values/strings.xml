    <string name="app_name">Riya</string>
    <string name="app_tagline">Your Warm Voice Companion &amp; Phone Controller</string>
    <string name="accessibility_service_description">Allows Riya to open apps, tap, type, scroll, control YouTube/media, and read screen content on your voice command. Banking, UPI, PIN, and OTP screens are strictly blocked.</string>

    <!-- Onboarding -->
    <string name="onboarding_greeting_title">Hii, ami Riya</string>
    <string name="onboarding_greeting_subtitle">Tomar kotha shunte, phone chalate, ar pashe thakte ami ready. Bengali, Banglish, Hindi ba English — je bhashay bolbe, sheibhabei kotha bolbo.</string>
