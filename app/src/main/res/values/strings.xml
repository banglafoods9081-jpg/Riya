    <string name="permissions_open_app_info">Open App Info</string>

    <!-- API Key Setup -->
    <string name="api_key_title">Connect Riya\'s Brain</string>
    <string name="api_key_subtitle">Enter your xAI Grok API key (xai-...) or Groq key (gsk_...). It is encrypted locally via Android Keystore (EncryptedSharedPreferences) and never leaves your phone except to talk to Riya\'s AI brain.</string>
    <string name="api_key_field_label">Grok API Key</string>
    <string name="api_key_field_placeholder">xai-... (or gsk_...)</string>
    <string name="api_key_verify_save">Verify &amp; Save Key</string>
    <string name="api_key_save_without_verify">Save Locally</string>
    <string name="api_key_clear">Remove Key</string>
    <string name="api_key_skip_for_now">Skip for Now</string>
    <string name="api_key_how_to_title">How to get your Grok (or Free Groq) Key</string>
    <string name="api_key_how_to_steps">• For xAI Grok: Open console.x.ai -> Sign in -> API Keys -> Create API Key (starts with xai-)\n• For free high-limit Groq: Open console.groq.com -> API Keys -> Create API Key (starts with gsk_)\n• Paste either key above — Riya auto-detects both!</string>
    <string name="api_key_status_saved">Key stored securely in EncryptedSharedPreferences</string>
    <string name="api_key_status_missing">No Grok API key saved yet</string>
    <string name="api_key_verified_success">Verified! Riya\'s Grok brain is ready.</string>

